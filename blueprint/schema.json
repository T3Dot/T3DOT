{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/T3Dot/T3Dot/main/blueprint/schema.json",
  "title": "t3dot company configuration bundle",
  "description": "All YAML files in a company config directory are merged by top-level key, then validated against this schema. Cross-references are checked by tools/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company",
    "profiles",
    "seats"
  ],
  "properties": {
    "company": {
      "$ref": "#/definitions/company"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/profile"
      }
    },
    "seats": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/seat"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/eventType"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/route"
      }
    },
    "predicates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/predicate"
      }
    },
    "leases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/lease"
      }
    },
    "budgets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/budget"
      }
    },
    "timers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/timer"
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/expectation"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/decisionType"
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/grant"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/integration"
      }
    },
    "monitors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/monitor"
      }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "eventTypeName": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "opName": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "opPattern": {
      "type": "string",
      "pattern": "^[a-z0-9_*]+(\\.[a-z0-9_*]+)*$"
    },
    "leaseName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{0,63}$"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^secret:[A-Za-z0-9._/-]+$"
    },
    "absPath": {
      "type": "string",
      "pattern": "^/"
    },
    "actorRef": {
      "type": "string",
      "pattern": "^(seat|script|environment):[a-z0-9][a-z0-9._-]*$"
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "status3": {
      "enum": [
        "existing",
        "missing",
        "planned",
        "retired"
      ]
    },
    "notes": {
      "type": "string"
    },
    "slugList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/slug"
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "timezone",
        "mode",
        "brands",
        "environments"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "name": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "full",
            "bridge"
          ],
          "description": "full: the t3dot kernel runs everything. bridge: the org keeps its own kernel and adopts the Bridge; sections other than company/profiles/seats are descriptive."
        },
        "brands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/slug"
              },
              "name": {
                "type": "string"
              },
              "notes": {
                "$ref": "#/definitions/notes"
              }
            }
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/environment"
          }
        },
        "kernel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listen": {
              "type": "string"
            },
            "os_user": {
              "type": "string"
            },
            "db_path": {
              "$ref": "#/definitions/absPath"
            },
            "change_control": {
              "enum": [
                "direct",
                "decided"
              ]
            },
            "notes": {
              "$ref": "#/definitions/notes"
            },
            "store": {
              "type": "string",
              "description": "Free text for kernels not on SQLite (bridge mode), e.g. \"postgres :5433\"."
            }
          }
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global": {
              "type": "integer",
              "minimum": 1
            },
            "per_provider": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "notes": {
              "$ref": "#/definitions/notes"
            }
          }
        },
        "quiet_hours": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/definitions/hhmm"
            },
            "end": {
              "$ref": "#/definitions/hhmm"
            },
            "applies_to": {
              "type": "string"
            },
            "notes": {
              "$ref": "#/definitions/notes"
            }
          }
        },
        "pause_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "scope"
            ],
            "properties": {
              "path": {
                "$ref": "#/definitions/absPath"
              },
              "scope": {
                "type": "string",
                "pattern": "^(global|brand:[a-z0-9._-]+|seat:[a-z0-9._-]+|integration:[a-z0-9._-]+)$"
              },
              "notes": {
                "$ref": "#/definitions/notes"
              },
              "ops": {
                "enum": [
                  "writes",
                  "all"
                ],
                "description": "writes (default): brokered writes and admission stop; all: reads stop too."
              },
              "expires_from_content": {
                "type": "boolean",
                "description": "The file holds resume_after=<ISO>; the pause clears at that time."
              }
            }
          }
        },
        "presenter": {
          "$ref": "#/definitions/slug"
        },
        "floors": {
          "$ref": "#/definitions/slugList"
        },
        "rotation_defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 500
            },
            "max_age_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/slug"
              },
              "kind": {
                "enum": [
                  "console_cards",
                  "approvals_api",
                  "telegram",
                  "t3_thread",
                  "email"
                ]
              },
              "settings": {
                "type": "object"
              },
              "status": {
                "$ref": "#/definitions/status3"
              },
              "notes": {
                "$ref": "#/definitions/notes"
              }
            }
          }
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decisions": {
              "$ref": "#/definitions/slug"
            },
            "assist": {
              "$ref": "#/definitions/slug"
            },
            "alerts": {
              "$ref": "#/definitions/slugList"
            }
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/slug"
              },
              "description": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "$ref": "#/definitions/status3"
              },
              "notes": {
                "$ref": "#/definitions/notes"
              }
            }
          }
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "t3_url"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "label": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "t3_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "t3_version": {
          "type": "string"
        },
        "os_user": {
          "type": "string"
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mcp": {
              "$ref": "#/definitions/secretRef"
            },
            "session": {
              "$ref": "#/definitions/secretRef"
            },
            "c1_access": {
              "enum": [
                "approval-required",
                "auto-accept-edits",
                "auto",
                "full-access"
              ],
              "description": "Access level C1 was approved at; seat profiles on this environment must not exceed it."
            },
            "webhook": {
              "$ref": "#/definitions/secretRef"
            }
          }
        },
        "settings": {
          "type": "object",
          "description": "T3 environment settings the bridge expects (documented, not applied by the validator)."
        },
        "status": {
          "$ref": "#/definitions/status3"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "driver",
        "environment",
        "posture",
        "runtime_mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "kind": {
          "enum": [
            "seat",
            "worker"
          ]
        },
        "driver": {
          "enum": [
            "claudeAgent",
            "codex"
          ]
        },
        "environment": {
          "$ref": "#/definitions/slug"
        },
        "posture": {
          "enum": [
            "standard",
            "confined"
          ]
        },
        "model": {
          "type": "string"
        },
        "runtime_mode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "idle_compaction": {
          "enum": [
            "off",
            "beforeCacheExpires",
            "default"
          ]
        },
        "home": {
          "type": "string"
        },
        "doctrine_file": {
          "$ref": "#/definitions/absPath"
        },
        "settings_file": {
          "$ref": "#/definitions/absPath"
        },
        "launch_args": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "secret": {
                "$ref": "#/definitions/secretRef"
              }
            }
          }
        },
        "t3_tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "$ref": "#/definitions/notes"
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "network": {
              "enum": [
                "open",
                "proxy",
                "allowlist",
                "off"
              ]
            },
            "allowed_domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "proxy_port": {
              "type": "integer"
            },
            "deny_read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allow_write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "os_user": {
              "type": "string"
            },
            "notes": {
              "$ref": "#/definitions/notes"
            },
            "deny_write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allow_read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny_env": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "$ref": "#/definitions/status3"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        },
        "model_options": {
          "type": "object",
          "description": "Provider model options, e.g. {effort: high}."
        }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "brands",
        "class",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "title": {
          "type": "string"
        },
        "brands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/slug"
          }
        },
        "reports_to": {
          "anyOf": [
            {
              "$ref": "#/definitions/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "class": {
          "enum": [
            "reader",
            "actor",
            "presenter",
            "operator"
          ]
        },
        "profile": {
          "$ref": "#/definitions/slug"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "retired",
            "planned"
          ]
        },
        "executor": {
          "anyOf": [
            {
              "enum": [
                "t3",
                "native"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claudeAgent": {
                  "enum": [
                    "t3",
                    "native"
                  ]
                },
                "codex": {
                  "enum": [
                    "t3",
                    "native"
                  ]
                }
              }
            }
          ],
          "description": "Bridge mode only: executor per seat, or per engine."
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_id": {
              "type": "string"
            },
            "path": {
              "$ref": "#/definitions/absPath"
            },
            "notes": {
              "$ref": "#/definitions/notes"
            }
          }
        },
        "human_chat": {
          "type": "boolean"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "wake": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coalesce_window_s": {
              "type": "integer",
              "minimum": 0
            },
            "max_events": {
              "type": "integer",
              "minimum": 1
            },
            "max_wakes_per_day": {
              "type": "integer",
              "minimum": 1
            },
            "ttl_s": {
              "type": "integer",
              "minimum": 60
            },
            "min_interval_s": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 500
            },
            "max_age_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "doctrine": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budgets": {
          "$ref": "#/definitions/slugList"
        },
        "predicates": {
          "$ref": "#/definitions/slugList"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thread_id": {
              "type": "string"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "notes": {
              "$ref": "#/definitions/notes"
            }
          }
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "$ref": "#/definitions/notes"
        },
        "binding_model": {
          "enum": [
            "per_seat",
            "per_conversation"
          ],
          "description": "per_seat (the t3dot default): one long-lived thread per seat, rotated. per_conversation (typical in bridge mode): one T3 thread per goal, project or task conversation, recorded by the org's runner."
        },
        "per_work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "description": "Makes this seat a work-seat template: one instance per open work item of this kind (blueprint §5.9).",
          "properties": {
            "kind": {
              "enum": [
                "goal",
                "project",
                "job"
              ]
            },
            "owners": {
              "$ref": "#/definitions/slugList"
            },
            "max_active": {
              "type": "integer",
              "minimum": 1
            },
            "close_decision": {
              "$ref": "#/definitions/slug"
            },
            "notes": {
              "$ref": "#/definitions/notes"
            }
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "retired"
          }
        }
      },
      "else": {
        "required": [
          "profile"
        ]
      }
    },
    "eventType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "priority",
        "pii"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/eventTypeName"
        },
        "description": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/definitions/priority"
        },
        "pii": {
          "enum": [
            "none",
            "refs",
            "contains"
          ]
        },
        "sources": {
          "$ref": "#/definitions/slugList"
        },
        "payload": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "routing": {
          "enum": [
            "routed",
            "informational"
          ]
        },
        "status": {
          "$ref": "#/definitions/status3"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "kind": {
          "enum": [
            "http",
            "file_tail",
            "record_outbox",
            "timer",
            "monitor",
            "t3_watch",
            "mcp"
          ]
        },
        "owner": {
          "type": "string"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hmac_secret": {
              "$ref": "#/definitions/secretRef"
            }
          }
        },
        "path": {
          "type": "string"
        },
        "format": {
          "enum": [
            "ndjson",
            "json",
            "lines"
          ]
        },
        "map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "key"
            ],
            "properties": {
              "when": {
                "type": "object"
              },
              "type": {
                "$ref": "#/definitions/eventTypeName"
              },
              "key": {
                "type": "string"
              },
              "brand": {
                "type": "string"
              },
              "subject": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "notes": {
                "$ref": "#/definitions/notes"
              },
              "each": {
                "type": "string",
                "description": "Fan-out path: one event per element, e.g. \"$.items[*]\"."
              },
              "hash": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Payload paths replaced by a salted ref at ingress (PII)."
              }
            }
          }
        },
        "status": {
          "$ref": "#/definitions/status3"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "on",
        "to",
        "settle"
      ],
      "properties": {
        "id": {
